<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in pages %}
    <url>
        <loc>{{ page_path(page, constant('Symfony\\Component\\Routing\\Generator\\UrlGeneratorInterface::ABSOLUTE_URL')) }}</loc>
        <lastmod>{{ page.updatedAt|date('Y-m-d') }}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>{{ page.home ? '1.0' : '0.5' }}</priority>
    </url>
{% endfor %}
</urlset>
