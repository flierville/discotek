{# Legacy grey box listing every error at the top of the form. #}
{% set all_errors = form.vars.errors.form.errors(true) %}
{% if form.vars.submitted and all_errors|length > 0 %}
    <div class="form-errors" role="alert">
        <p class="form-errors__title">Erreur(s) détectée(s) :</p>
        <ul>
            {% for error in all_errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
