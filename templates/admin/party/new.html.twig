{% extends 'admin/base.html.twig' %}

{% block title %}Nouvelle soirée{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('admin_party_index') }}" class="text-sm text-slate-500 hover:text-brand-600">&larr; Photos de soirées</a>
        <h1 class="page-title mt-1">Nouvelle soirée</h1>
        <p class="mt-1 text-sm text-slate-500">Créez la soirée avant l'événement pour donner le code aux invités, ajoutez les photos le lendemain.</p>
    </div>

    <section class="card max-w-3xl">
        {{ include('admin/party/_form.html.twig', {submit_label: 'Créer la soirée'}) }}
    </section>
{% endblock %}
