{% extends 'admin/base.html.twig' %}

{% block title %}Mon compte{% endblock %}

{% block body %}
    <div class="mb-6">
        <h1 class="page-title">Mon compte</h1>
        <p class="mt-1 text-sm text-slate-500">Connecté en tant que {{ app.user.email }}{% if app.user.lastLoginAt %} - dernière connexion le {{ app.user.lastLoginAt|format_datetime('long', 'short', locale: 'fr') }}{% endif %}.</p>
    </div>

    <section class="card max-w-xl">
        <div class="card-header"><h2 class="card-title">Changer mon mot de passe</h2></div>
        {{ form_start(form, {attr: {class: 'card-body space-y-5'}}) }}
            {{ form_row(form.currentPassword) }}
            {{ form_row(form.newPassword) }}
            <button type="submit" class="btn btn-primary">Modifier le mot de passe</button>
        {{ form_end(form) }}
    </section>
{% endblock %}
