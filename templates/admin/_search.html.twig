{# Parameters: search, placeholder #}
<form method="get" class="relative w-full sm:w-72" role="search">
    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
        {{ include('admin/_icon.html.twig', {name: 'search', class: 'size-4'}) }}
    </span>
    <input type="search" name="q" value="{{ search }}" placeholder="{{ placeholder }}" class="form-input pl-9" aria-label="{{ placeholder }}">
</form>
